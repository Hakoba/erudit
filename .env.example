# Дефолты для dev-сборки. В прод-сборку значения не попадают (см. define.config.mjs).
# Ключ сервисного аккаунта Yandex AI Studio (роль ai.languageModels.user)
YANDEX_API_KEY=
# Идентификатор каталога — подставляется в имя модели gpt://<folder>/yandexgpt/latest
YANDEX_FOLDER_ID=

# Загрузка в Chrome Web Store (chrome-webstore-upload-cli). OAuth-клиент типа Desktop
# в Google Cloud с включённым Chrome Web Store API; refresh token выдаёт
# `npx chrome-webstore-upload-keys`. Publisher id — UUID из адреса панели разработчика.
EXTENSION_ID=
PUBLISHER_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
